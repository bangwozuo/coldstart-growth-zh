{
  "workflow_id": "de_dev_01_wf05",
  "name": "数据驱动选题迭代",
  "type": "composite",
  "input": {
    "type": "object",
    "required": ["week", "ltv", "channels"],
    "properties": {
      "week": {"type": "string", "description": "复盘周，如 2026-W40"},
      "ltv": {"type": "number", "description": "用户 LTV（¥），估算须注明口径；缺失时上游拒绝执行"},
      "channels": {
        "type": "array",
        "description": "渠道数据（UTM 归因后）：name/spend/impressions/clicks/signups/activated/paying/revenue"
      },
      "active_topics": {
        "type": "array",
        "description": "在跑选题：topic / channel / week_signups"
      }
    }
  },
  "output": {
    "type": "object",
    "required": ["weights", "plan"],
    "properties": {
      "weights": {
        "type": "array",
        "description": "选题权重更新：↑ 加权（系列化）/ → 暂缓（先修漏斗）/ ↓ 降权（转向），周注册<30 判定降级"
      },
      "plan": {
        "type": "array",
        "description": "下周选题计划：动作 + 与 daily-topic-mine-flow / devlog-to-content-flow 的衔接"
      },
      "artifacts": {
        "type": "array",
        "description": "out/复盘与选题迭代清单.xlsx、out/topic_iterate_result.json、out/review.json（上游产物）"
      }
    },
    "x-scripts": ["scripts/run_flow.py"],
    "x-orchestrates": ["de_dev_01_sk07"]
  },
  "constraints": {
    "max_input_length": 10000,
    "forbidden_words": ["最好", "第一", "100%"],
    "ai_label_required": true,
    "human_review_required": true
  }
}
